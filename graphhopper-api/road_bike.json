{
  "distance_influence": 70,
  "speed": [
    { "if": "surface == ASPHALT || surface == PAVED || surface == CONCRETE", "multiply_by": "1.1" },
    { "if": "surface == COMPACTED || surface == FINE_GRAVEL",                "multiply_by": "0.8" },
    { "if": "surface == GRAVEL || surface == UNPAVED",                       "multiply_by": "0.6" },
    { "if": "surface == DIRT || surface == GROUND || surface == SAND",       "multiply_by": "0.3" },
    { "if": "smoothness == BAD || smoothness == VERY_BAD || smoothness == HORRIBLE || smoothness == VERY_HORRIBLE || smoothness == IMPASSABLE", "multiply_by": "0.4" }
  ],
  "priority": [
    { "if": "road_access == PRIVATE || road_access == DESTINATION",          "multiply_by": "0"   },
    { "if": "road_class == MOTORWAY || road_class == TRUNK",                 "multiply_by": "0"   },
    { "if": "road_class == CYCLEWAY",                                        "multiply_by": "1.5" },
    { "if": "bike_network != MISSING",                                       "multiply_by": "1.3" },
    { "if": "road_class == PRIMARY",                                         "multiply_by": "0.3" },
    { "if": "road_class == SECONDARY",                                       "multiply_by": "0.7" },
    { "if": "road_class == TRACK",                                           "multiply_by": "0.2" },
    { "if": "road_class == PATH",                                            "multiply_by": "0.15"},
    { "if": "road_class == SERVICE",                                         "multiply_by": "0.4" },
    { "if": "road_class == STEPS",                                           "multiply_by": "0"   },
    { "if": "surface == DIRT || surface == GROUND || surface == SAND",       "multiply_by": "0.2" },
    { "if": "track_type == GRADE4 || track_type == GRADE5",                  "multiply_by": "0.1" },
    { "if": "road_environment == TUNNEL",                                    "multiply_by": "0.5" },
    { "if": "max_speed >= 80",                                               "multiply_by": "0.5" }
  ]
}
